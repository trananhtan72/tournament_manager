# vitest 5's peer range for @types/node (^22 || >=24) is newer than the
# @types/node version this repo's other tooling pulls in (vite/next-era
# packages resolve @types/node@20.x). npm's strict resolver treats that as
# an unresolvable ERESOLVE conflict even though it's a type-only, dev-only
# mismatch that doesn't affect runtime. Vercel's build does a clean
# `npm install` and hits this immediately; local installs only skip it
# because they reuse an existing lockfile. legacy-peer-deps makes both
# environments behave the same way.
legacy-peer-deps=true
