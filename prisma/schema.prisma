generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  // Null for an account that's only ever signed in with Google (or another
  // future OAuth provider) — see auth.ts's Credentials authorize(), which
  // treats a null hash as "this account has no password to check against."
  passwordHash        String?
  // Auth.js's Prisma adapter writes both of these on every OAuth sign-in
  // (handle-login.js always passes emailVerified, and the Google provider's
  // default profile mapping always passes image) — required for the adapter
  // to create a user at all, not just nice-to-haves.
  emailVerified       DateTime?
  image               String?
  // ADMIN can create tournaments and grant/revoke ORGANIZER access; ORGANIZER
  // can create tournaments; USER (the default) cannot. See lib/roles.ts.
  role                UserRole             @default(USER)
  createdAt           DateTime             @default(now())
  tournaments         Tournament[]
  refereeRoles        TournamentReferee[]
  entryPlayers        EntryPlayer[]
  teamMemberships     TeamMember[]
  payments            TournamentPayment[]
  notifications       Notification[]
  accounts            Account[]
  passwordResetTokens PasswordResetToken[]
}

enum UserRole {
  ADMIN
  ORGANIZER
  USER
}

// Auth.js's Prisma adapter shape for a linked OAuth account (e.g. Google) —
// field names match exactly what @auth/prisma-adapter and the provider's
// token mapping write, not a free choice. Only this model is needed (not
// Session/VerificationToken/Authenticator, also part of Auth.js's "standard"
// schema): sessions use the JWT strategy, so the adapter's session methods
// are never called, and nothing here uses email-link or passkey sign-in.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// A single-use "forgot password" link for an email/password account. Only
// tokenHash (a SHA-256 of the raw token emailed to the user) is ever stored —
// never the raw token itself — so a leaked row alone can't be used to reset
// anyone's password; see lib/passwordReset.ts.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  // Null until the link is used (or superseded by a newer request) — see
  // resetPassword in app/actions/passwordReset.ts.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum EventCategory {
  SINGLES
  DOUBLES
  TEAM
}

enum DrawFormat {
  SINGLE_ELIMINATION
  ROUND_ROBIN
  POOLS_KNOCKOUT
}

model Tournament {
  id                   String              @id @default(cuid())
  slug                 String              @unique
  name                 String
  venue                String
  startDate            DateTime
  endDate              DateTime
  registrationDeadline DateTime
  // Optional. Entries open at the start of this day (null = open straight away).
  registrationOpensAt  DateTime?
  // Optional. Players can withdraw through the end of this day (null = the
  // registration deadline).
  withdrawalDeadline   DateTime?
  // How many courts the venue has (courts are named "Court 1" … "Court N").
  courtCount           Int                 @default(12)
  // Caps how many events one player may be the INITIATOR of in this
  // tournament (see RegistrationDialog) — doesn't count entries they only
  // joined as an invited doubles partner.
  maxEventsPerUser     Int                 @default(5)
  // One organizer-set duration for every match in the tournament, used
  // wherever match timing needs an assumed length — the bulk schedule tool,
  // the post-match cascade reschedule, and the dashboard's "next match"
  // estimate — so they never drift apart the way separate, re-entered
  // per-action values could.
  matchDurationMinutes Int                 @default(45)
  // Optional rich-text regulations document: a ProseMirror doc restricted to
  // the nodes/marks in lib/regulations.ts. Players read it in a popup.
  regulations          Json?
  organizerId          String
  organizer            User                @relation(fields: [organizerId], references: [id])
  events               Event[]
  referees             TournamentReferee[]
  payments             TournamentPayment[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([organizerId])
}

// A registered user the organizer has approved to officiate this tournament's
// matches. A referee can score only the matches assigned to them (see
// Match.refereeId); removing a referee unassigns those matches.
model TournamentReferee {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  matches      Match[]
  createdAt    DateTime   @default(now())

  @@unique([tournamentId, userId])
  @@index([userId])
}

model Event {
  id                    String          @id @default(cuid())
  tournamentId          String
  tournament            Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name                  String
  category              EventCategory
  drawFormat            DrawFormat      @default(SINGLE_ELIMINATION)
  drawPublished         Boolean         @default(false)
  // Game rules: best of `gamesPerMatch` games, each to `pointsPerGame` (win by
  // 2, capped 9 above the target — BWF: 21 -> 30). Defaults are the BWF
  // standard. For pools+knockout these are the POOL-stage rules, and the
  // knockout* pair sets the knockout stage separately (null = same as pools).
  gamesPerMatch         Int             @default(3)
  pointsPerGame         Int             @default(21)
  knockoutGamesPerMatch Int?
  knockoutPointsPerGame Int?
  // Informational only — shown to organizers and to players choosing events
  // to register for. Doesn't feed TournamentPayment, which stays a separate,
  // organizer-entered record of what was actually collected.
  entryFee              Decimal?        @db.Decimal(10, 2)
  entries               Entry[]
  matches               Match[]
  pools                 Pool[]
  // TEAM-category events only — see Team/TieFormatSlot/Tie below.
  teams                 Team[]
  tieFormatSlots        TieFormatSlot[]
  ties                  Tie[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@unique([tournamentId, name])
}

enum EntryStatus {
  NEEDS_PARTNER
  PENDING_PARTNER
  // Player self-registrations (and accepted doubles pairs) wait here until
  // the organizer approves them into CONFIRMED.
  PENDING_APPROVAL
  CONFIRMED
}

enum EntryPlayerRole {
  INITIATOR
  PARTNER
}

model Entry {
  id              String        @id @default(cuid())
  eventId         String
  event           Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  status          EntryStatus
  seed            Int?
  poolId          String?
  pool            Pool?         @relation(fields: [poolId], references: [id])
  players         EntryPlayer[]
  matchesAsEntry1 Match[]       @relation("MatchEntry1")
  matchesAsEntry2 Match[]       @relation("MatchEntry2")
  matchesWon      Match[]       @relation("MatchWinner")
  // Set when this Entry is a TEAM event's 1:1 shim for a Team (see Team.entryId).
  team            Team?
  tiesAsTeam1     Tie[]         @relation("TieTeam1")
  tiesAsTeam2     Tie[]         @relation("TieTeam2")
  tiesWon         Tie[]         @relation("TieWinner")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([eventId, seed])
}

// Pools + knockout only: entries are split into pools (round-robin within
// each), and the top 1-2 per pool advance into a single-elimination
// knockout stage. Pool-stage matches carry a poolId; knockout-stage matches
// don't (and use round numbers starting fresh at 1, same as a plain
// single-elimination draw, since pool matches are all stored at round 0).
model Pool {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  entries   Entry[]
  matches   Match[]
  createdAt DateTime @default(now())

  @@unique([eventId, name])
}

// A player in an entry is either a registered User (userId set) or a
// walk-in added directly by the organizer with just a name (guestName set).
//
// No @@unique([eventId, userId]) here (removed — previously enforced "a user
// can only have one entry per event" at the DB level). That guarantee only
// ever mattered for self-service registration, which is enforced instead by
// an explicit check in registerSingles/registerWithPartner/quickAddEntry
// (app/actions/entries.ts). A TEAM event's rubber matches legitimately give
// the same player a fresh EntryPlayer row in every tie they play.
model EntryPlayer {
  id        String          @id @default(cuid())
  entryId   String
  entry     Entry           @relation(fields: [entryId], references: [id], onDelete: Cascade)
  eventId   String
  userId    String?
  user      User?           @relation(fields: [userId], references: [id])
  guestName String?
  role      EntryPlayerRole
  confirmed Boolean         @default(true)
  createdAt DateTime        @default(now())
}

// A team registered for a TEAM-category event. Gets a 1:1 shim Entry
// (entryId) purely so the existing bracket/round-robin draw generation and
// standings code — which only ever operates on an Entry id, never on what's
// "inside" it — can run completely unchanged at the team level. See
// lib/tournament/ties.ts.
model Team {
  id        String       @id @default(cuid())
  eventId   String
  event     Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  entryId   String?      @unique
  entry     Entry?       @relation(fields: [entryId], references: [id])
  members   TeamMember[]
  createdAt DateTime     @default(now())

  @@unique([eventId, name])
}

// A player on a team's roster — a registered User (userId set) or a
// walk-in (guestName set), the same user-or-guest convention as EntryPlayer.
// Rosters have no fixed player-to-slot mapping; who plays which tie slot is
// decided per tie (see Tie, and submitTieLineup in app/actions/ties.ts).
model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  guestName String?
  createdAt DateTime @default(now())
}

enum TieSlotType {
  SINGLES
  DOUBLES
}

// One slot in a TEAM event's tie format template — e.g. "Singles 1",
// "Doubles 2" — applied to every tie in the event. Together these slots
// define how many individual rubbers make up a tie (the "standard 5-match
// tie," or any custom count) and each rubber's type and game format. See
// lib/tournament/tieFormat.ts for the standard preset and custom validation.
model TieFormatSlot {
  id            String      @id @default(cuid())
  eventId       String
  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  order         Int
  label         String
  type          TieSlotType
  gamesPerMatch Int
  pointsPerGame Int

  @@unique([eventId, order])
}

// The bracket/round-robin slot for one team-vs-team pairing in a TEAM
// event — takes over the role Match's round/position/entry1/entry2/winner/
// isBye play for individual events, but at the team level. A Tie is never
// scored directly: its outcome is aggregated from its individual rubber
// Matches (Match.tieId) by computeTieWinner in lib/tournament/ties.ts.
model Tie {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  round       Int
  position    Int
  team1Id     String?
  team1Entry  Entry?   @relation("TieTeam1", fields: [team1Id], references: [id])
  team2Id     String?
  team2Entry  Entry?   @relation("TieTeam2", fields: [team2Id], references: [id])
  winnerId    String?
  winnerEntry Entry?   @relation("TieWinner", fields: [winnerId], references: [id])
  isBye       Boolean  @default(false)
  matches     Match[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([eventId, round, position])
}

// One athlete's payment record for a whole tournament (every event they've
// entered), not per event-registration — an athlete typically pays once,
// covering however many events they signed up for. Identified by a
// registered user's id when known, else by matching guest name within the
// tournament: guests have no stable cross-entry identity anywhere else in
// this app either (see schedule.ts's rest-constraint handling), so two
// different guests sharing a name would be (incorrectly) treated as the same
// payer — an accepted, known limitation. Organizer-only; created the first
// time the organizer sets anything for that athlete.
model TournamentPayment {
  id           String         @id @default(cuid())
  tournamentId String
  tournament   Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?          @relation(fields: [userId], references: [id])
  guestName    String?
  amount       Decimal?       @db.Decimal(10, 2)
  method       PaymentMethod?
  note         String?
  // Set the moment the organizer clicks "Pay" (the organizer's own device
  // clock, same floating convention used elsewhere); null means not yet paid.
  paidAt       DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([tournamentId, userId])
  @@unique([tournamentId, guestName])
}

enum PaymentMethod {
  CASH
  ZELLE
  OTHER
}

enum MatchStatus {
  COMPLETED
  WALKOVER
  RETIRED
}

// Round 1 = first round. Position is 0-indexed within a round. A round-1
// match with no entry2 is a bye (entry1 auto-advances as winner). Matches in
// later rounds start with null entries, filled in as earlier rounds resolve,
// either by a bye (isBye) or by a recorded result (status + winnerId) on the
// feeder match. Editing an already-recorded result cascades: any later match
// whose entries depended on the old winner has its own result cleared too.
model Match {
  id            String             @id @default(cuid())
  eventId       String
  event         Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  poolId        String?
  pool          Pool?              @relation(fields: [poolId], references: [id], onDelete: Cascade)
  // Set only for a TEAM event's individual rubber matches: which Tie this
  // belongs to, and which slot (e.g. "Singles 1") it fills. A rubber's
  // position is offset as `tie.position * 100 + slotIndex`, well clear of
  // any realistic tie/slot count, so @@unique([eventId, round, position])
  // below never collides with another rubber or a team-level bracket slot.
  tieId         String?
  tie           Tie?               @relation(fields: [tieId], references: [id], onDelete: Cascade)
  tieSlotLabel  String?
  round         Int
  position      Int
  entry1Id      String?
  entry1        Entry?             @relation("MatchEntry1", fields: [entry1Id], references: [id])
  entry2Id      String?
  entry2        Entry?             @relation("MatchEntry2", fields: [entry2Id], references: [id])
  winnerId      String?
  winner        Entry?             @relation("MatchWinner", fields: [winnerId], references: [id])
  isBye         Boolean            @default(false)
  status        MatchStatus?
  // Per-match override of the event's game format — set for a TEAM event's
  // rubber matches (copied from their TieFormatSlot when the lineup is
  // submitted), since one team event can mix singles- and doubles-format
  // rubbers. Null for every other match, which keeps using the event-level
  // format via gameFormatForMatch() in lib/tournament/gameFormat.ts.
  gamesPerMatch Int?
  pointsPerGame Int?
  // Optional schedule slot. scheduledAt is a "floating" wall-clock time: the
  // UTC fields hold the venue's local time (like the tournament dates, which
  // are stored as UTC midnight), so it's always read and shown in UTC.
  scheduledAt   DateTime?
  court         String?
  // Live point-by-point scoring. A match is "live" once liveStartedAt is set
  // and it has no result yet; firstServer (1 or 2) is which entry served the
  // first rally. The current score is never stored — it's replayed from
  // `points` (see lib/tournament/liveScoring.ts).
  liveStartedAt DateTime?
  firstServer   Int?
  // When the match actually began: a venue-local wall-clock time, stored the
  // same "floating" way as scheduledAt. Saved with every played result. This
  // is the "actual start" the estimated schedule (lib/tournament/schedule.ts)
  // reads — there's no separate field for it.
  startedAt     DateTime?
  // When the match's result was actually recorded — also set for a walkover
  // or retirement, since the slot resolves the moment it's decided, not when
  // play would have ended. Same floating convention as startedAt. Distinct
  // from updatedAt, which also moves if the result is edited later. Read by
  // the estimated schedule to know when a court/player frees up.
  actualEnd     DateTime?
  // The referee assigned to score this match (null = only the organizer).
  refereeId     String?
  referee       TournamentReferee? @relation(fields: [refereeId], references: [id], onDelete: SetNull)
  points        MatchPoint[]
  games         MatchGame[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([eventId, round, position])
}

// One rally in a live-scored match: which side (1 = entry1, 2 = entry2) won
// it, in order (seq starts at 1). Undo deletes the last one.
model MatchPoint {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  seq       Int
  side      Int
  createdAt DateTime @default(now())

  @@unique([matchId, seq])
}

model MatchGame {
  id          String @id @default(cuid())
  matchId     String
  match       Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  gameNumber  Int
  entry1Score Int
  entry2Score Int

  @@unique([matchId, gameNumber])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}
