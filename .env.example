# PostgreSQL connection string (Neon). Use the pooled connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js secret. Generate with: npx auth secret
AUTH_SECRET=""

# Optional. Google OAuth client for "Sign in with Google" — from
# console.cloud.google.com (APIs & Services > Credentials > OAuth client ID,
# type "Web application"). Authorized redirect URI:
# <your-origin>/api/auth/callback/google. Leave blank to run on
# email/password sign-in only.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional. Resend (resend.com) API key, for the "forgot password" email.
# Leave blank to have the reset link logged to the server console instead of
# emailed — the reset flow itself still works end to end either way.
RESEND_API_KEY=""
# Optional. "Name <email@domain>" — defaults to Resend's shared
# onboarding@resend.dev sender, which only delivers to the email your Resend
# account itself was signed up with.
RESEND_FROM_EMAIL=""
